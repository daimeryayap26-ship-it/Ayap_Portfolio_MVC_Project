@model MyPortfolio.Models.Project

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill mb-4">
        <i class="bi bi-arrow-left me-1"></i> Back to All Projects
    </a>

    <div class="card border-0 shadow-sm rounded-3 p-4 mb-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <img src="@Model.ImageUrl" class="img-fluid rounded-3 shadow-sm w-100" style="max-height: 350px; object-fit: cover;" alt="@Model.Title" />
            </div>
            <div class="col-lg-6">
                <span class="badge bg-primary mb-2">Project Details</span>
                <h2 class="fw-bold mb-3">@Model.Title</h2>
                <p class="text-muted lead fs-6">@Model.Description</p>
                <hr class="my-4" />
                <div>
                    <a href="@Model.GitHubUrl" target="_blank" class="btn btn-dark btn-lg rounded-pill px-4">
                        <i class="bi bi-github me-2"></i> View Repository
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Comment Section -->
    <div class="row">
        <div class="col-lg-8">
            <h4 class="fw-bold mb-4"><i class="bi bi-chat-left-text me-2"></i>Project Feedback</h4>

            <div class="card border-0 shadow-sm rounded-3 p-4 mb-4">
                <h6 class="fw-bold mb-3">Leave a comment</h6>
                <form asp-action="AddComment" method="post">
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    <div class="mb-3">
                        <textarea name="commentText" class="form-control" rows="3" placeholder="Write your thoughts about this project..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-send me-1"></i> Post Comment
                    </button>
                </form>
            </div>

            <div class="vstack gap-3">
                @if (Model.Comments.Any())
                {
                    @foreach (var comment in Model.Comments)
                    {
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                            <div class="d-flex align-items-center mb-2">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="fw-bold small">Reviewer</span>
                            </div>
                            <p class="mb-0 text-secondary ps-4">@comment</p>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-light text-muted border text-center py-4">
                        <i class="bi bi-chat-square-dots fs-3 d-block mb-2"></i>
                        No comments yet. Be the first to leave feedback!
                    </div>
                }
            </div>
        </div>
    </div>
</div>