@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center align-items-center min-vh-100 my-n5">
    <div class="col-md-5 col-lg-4">
        <div class="chromic-card p-4 p-sm-5 rounded-0 shadow-lg border border-secondary border-opacity-50">
            <div class="text-center mb-4">
                <i class="bi bi-terminal-fill fs-1 text-white d-block mb-2"></i>
                <h3 class="fw-bold text-white text-uppercase tracking-wider mb-1">Portfolio Access</h3>
                <p class="text-secondary small">Please authenticate to continue</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger bg-danger bg-opacity-10 border-danger text-danger rounded-0 small mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label text-secondary small text-uppercase fw-semibold">Username</label>
                    <input type="text" name="username" class="form-control bg-dark text-white border-secondary rounded-0 py-2" placeholder="admin" required autocomplete="off" />
                </div>
                <div class="mb-4">
                    <label class="form-label text-secondary small text-uppercase fw-semibold">Password</label>
                    <input type="password" name="password" class="form-control bg-dark text-white border-secondary rounded-0 py-2" placeholder="••••••••" required />
                </div>
                <button type="submit" class="btn btn-chromic w-100 rounded-0 py-2 text-uppercase fw-bold tracking-wider">
                    Sign In <i class="bi bi-arrow-right ms-2"></i>
                </button>
            </form>
        </div>
    </div>
</div>